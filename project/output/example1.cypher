// ---- INDEX ----
CREATE INDEX user_gen_id IF NOT EXISTS FOR (n:User) ON (n.gen_id);
CREATE INDEX namespace_gen_id IF NOT EXISTS FOR (n:Namespace) ON (n.gen_id);

